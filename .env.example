POSTGRES_PORT=your_port

# PostgreSQL administrator: used only to initialize service databases.
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

DIRECTORY_POSTGRES_DB=directory_db
DIRECTORY_POSTGRES_USER=directory_service
DIRECTORY_POSTGRES_PASSWORD=your_directory_password

EMPLOYEE_POSTGRES_DB=employee_db
EMPLOYEE_POSTGRES_USER=employee_service
EMPLOYEE_POSTGRES_PASSWORD=your_employee_password

GITHUB_NUGET_CREDENTIALS="your_connection_string"
