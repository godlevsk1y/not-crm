{
  "Seq": {
    "ServerUrl": "http://localhost:8081"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Exceptions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal",
        "Npgsql": "Fatal",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceName:l} {Message:lj} TraceId={TraceId}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:8081"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "AllowedHosts": "*",
  "DatabaseCleanupOptions": {
    "BatchSize": 1000,
    "Interval": "00:10:00",
    "RetentionDays": 30
  },
  "HybridCache": {
    "DefaultEntryOptions": {
      "Expiration": "00:30:00",
      "LocalCacheExpiration": "00:05:00"
    }
  }
}
