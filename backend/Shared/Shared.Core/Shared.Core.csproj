<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>GodlevskiyDev.Shared.Core</PackageId>
        <Version>1.0.0</Version>

        <Authors>GodlevskiyDev</Authors>
        <Company>GodlevskiyDev</Company>
        <Description>Shared application abstractions and validation for backend services.</Description>

        <RepositoryUrl>https://github.com/godlevsk1y/not-crm</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="FluentValidation" />
      <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
      <PackageReference Include="godlevskiydev.shared.kernel" />
      <PackageReference Include="Scrutor" />
    </ItemGroup>

</Project>
