<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>GodlevskiyDev.Shared.Framework</PackageId>
        <Version>1.0.0</Version>

        <Authors>GodlevskiyDev</Authors>
        <Company>GodlevskiyDev</Company>
        <Description>Shared ASP.NET Core middleware and HTTP results for backend services.</Description>

        <RepositoryUrl>https://github.com/godlevsk1y/not-crm</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <IsPackable>true</IsPackable>
    </PropertyGroup>
    
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="godlevskiydev.shared.kernel" />
    </ItemGroup>

</Project>
